# .gitignore for FruitCollectGameapi (ASP.NET Core)

# Ignore build outputs
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider project files
.idea/
*.sln.iml

# VS Code settings
.vscode/

# Environment files
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Other
*.swp
*.tmp
